#!/usr/bin/env bash
#
# fx-agent — Unified CLI for the FX Regime Lab agent system
# Replaces all individual scripts with one command.
#
# Usage:
#   fx-agent init                  # One-time setup
#   fx-agent status                # System health + current state
#   fx-agent spec create [type]    # Create spec from template (signal|page|migration)
#   fx-agent spec validate <file>  # Validate spec before delegation
#   fx-agent run <spec.md>         # Execute single spec via Cursor
#   fx-agent run --queue           # Process all queued specs
#   fx-agent verify                # Run full test suite
#   fx-agent maps                  # Regenerate all maps
#   fx-agent predict <spec.md>     # Predict failure modes in spec
#

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"

# Colors
R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
B='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${B}[fx-agent]${NC} $1"; }
log_ok()    { echo -e "${G}[fx-agent]${NC} ✓ $1"; }
log_warn()  { echo -e "${Y}[fx-agent]${NC} ⚠ $1"; }
log_err()   { echo -e "${R}[fx-agent]${NC} ✗ $1"; }

# ─── COMMANDS ──────────────────────────────────────────────────────────────

cmd_init() {
  log_info "Initializing FX Regime Lab agent system..."
  
  # Dependencies
  for dep in python3 node npm git agent jq; do
    if command -v "$dep" >/dev/null 2>&1; then
      log_ok "$dep installed"
    else
      log_err "$dep not found — install before proceeding"
      exit 1
    fi
  done
  
  # Git hooks
  mkdir -p .git/hooks
  cat > .git/hooks/post-commit << 'HOOKEOF'
#!/bin/bash
"$(git rev-parse --show-toplevel)/.agent/scripts/regenerate-maps.sh" git-hook &
HOOKEOF
  chmod +x .git/hooks/post-commit
  log_ok "post-commit hook installed"
  
  cat > .git/hooks/pre-commit << 'HOOKEOF'
#!/bin/bash
set -e
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^pipeline/|^web/'; then
  echo "[pre-commit] Running tests..."
  if git diff --cached --name-only | grep -q '^pipeline/'; then
    cd pipeline && pytest -q --tb=short
  fi
  if git diff --cached --name-only | grep -q '^web/'; then
    cd web && npm run build 2>/dev/null
  fi
fi
HOOKEOF
  chmod +x .git/hooks/pre-commit
  log_ok "pre-commit hook installed"
  
  # Initial maps
  ./.agent/scripts/regenerate-maps.sh init
  log_ok "Maps generated"
  
  # Make everything executable
  chmod +x .agent/scripts/*.sh scripts/*.sh 2>/dev/null || true
  
  log_ok "Initialization complete. Run 'fx-agent status' to verify."
}

cmd_status() {
  echo ""
  echo "═══════════════════════════════════════════════════"
  echo "  FX Regime Lab Agent System"
  echo "═══════════════════════════════════════════════════"
  echo ""
  
  # Quick health
  local errors=0
  
  [[ -f ".agent/maps/CODEMAP.json" ]] && log_ok "CODEMAP" || { log_err "CODEMAP missing"; errors=$((errors+1)); }
  [[ -f ".agent/maps/SKILLMAP.json" ]] && log_ok "SKILLMAP" || { log_err "SKILLMAP missing"; errors=$((errors+1)); }
  [[ -f ".agent/maps/RULEMAP.json" ]] && log_ok "RULEMAP" || { log_err "RULEMAP missing"; errors=$((errors+1)); }
  
  # Map freshness
  local map_age=$(( $(date +%s) - $(stat -c %Y .agent/maps/CODEMAP.json 2>/dev/null || echo 0) ))
  if [[ $map_age -lt 3600 ]]; then
    log_ok "Maps fresh (${map_age}s old)"
  else
    log_warn "Maps stale (${map_age}s old) — run 'fx-agent maps'"
  fi
  
  # Hooks
  [[ -x .git/hooks/post-commit ]] && log_ok "post-commit hook" || log_warn "post-commit hook missing"
  [[ -x .git/hooks/pre-commit ]] && log_ok "pre-commit hook" || log_warn "pre-commit hook missing"
  
  # Test suite
  if (cd pipeline && pytest -q --tb=line >/dev/null 2>&1); then
    log_ok "pytest passes"
  else
    log_err "pytest fails"
    errors=$((errors+1))
  fi
  
  echo ""
  echo "Quick stats:"
  echo "  Files mapped: $(python3 -c "
import json
d=json.load(open('.agent/maps/CODEMAP.json'))
total=0
for name, section in d.items():
    if name == 'meta': continue
    if isinstance(section, dict):
        for cat, files in section.items():
            total += len(files)
print(total)
")"
  echo "  Skills:       $(python3 -c "import json; print(len(json.load(open('.agent/maps/SKILLMAP.json'))['skills']))")"
  echo "  Rules:        $(python3 -c "import json; print(len(json.load(open('.agent/maps/RULEMAP.json'))['rules']))")"
  echo "  Scripts:      $(ls .agent/scripts/*.sh scripts/*.sh 2>/dev/null | wc -l)"
  
  echo ""
  if [[ $errors -eq 0 ]]; then
    echo -e "  ${G}System is healthy ✓${NC}"
  else
    echo -e "  ${R}$errors error(s) found${NC}"
  fi
  echo ""
}

cmd_spec_create() {
  local type="${1:-}"
  local template=""
  
  case "$type" in
    signal|pipeline)  template=".agent/templates/pipeline-signal.md" ;;
    page|web)         template=".agent/templates/nextjs-page.md" ;;
    migration|db)     template=".agent/templates/db-migration.md" ;;
    *)
      echo "Usage: fx-agent spec create <type>"
      echo "  Types: signal, page, migration"
      exit 1
      ;;
  esac
  
  local out=".cursor/delegation/queue/spec-$(date +%s).md"
  mkdir -p "$(dirname "$out")"
  cp "$template" "$out"
  log_ok "Spec created: $out"
  echo ""
  echo "Edit the spec, then run:"
  echo "  fx-agent run $out"
}

cmd_spec_validate() {
  local spec="${1:-}"
  if [[ -z "$spec" ]]; then
    log_err "Usage: fx-agent spec validate <spec.md>"
    exit 1
  fi
  ./.agent/scripts/spec-validator.sh "$spec"
}

cmd_run() {
  if [[ "${1:-}" == "--queue" ]]; then
    log_info "Processing delegation queue..."
    ./scripts/kimi-cursor-orchestrator.sh --process-queue --parallel 3 --yolo
    return
  fi
  
  local spec="${1:-}"
  if [[ -z "$spec" ]]; then
    log_err "Usage: fx-agent run <spec.md> | fx-agent run --queue"
    exit 1
  fi
  
  # Validate first
  log_info "Validating spec..."
  if ! ./.agent/scripts/spec-validator.sh "$spec" >/dev/null 2>&1; then
    log_warn "Spec validation failed — fix before running"
    ./.agent/scripts/spec-validator.sh "$spec"
    exit 1
  fi
  log_ok "Spec valid"
  
  # Predict failures
  log_info "Predicting failure modes..."
  ./.agent/scripts/predict-failures.sh "$spec" || true
  echo ""
  
  # Execute
  log_info "Delegating to Cursor Agent..."
  ./scripts/cursor-delegate.sh --spec "$spec" --yolo
  
  # Verify
  log_info "Running verification..."
  ./scripts/cursor-verify.sh --spec "$spec" || true
}

cmd_verify() {
  log_info "Running full verification suite..."
  
  local failed=0
  
  echo ""
  echo "Pipeline tests:"
  if (cd pipeline && pytest -q --tb=short); then
    log_ok "pytest"
  else
    log_err "pytest"
    failed=1
  fi
  
  echo ""
  echo "Frontend build:"
  if (cd web && npm run build 2>/dev/null); then
    log_ok "npm run build"
  else
    log_err "npm run build"
    failed=1
  fi
  
  echo ""
  echo "Frontend lint:"
  if (cd web && npm run lint 2>/dev/null); then
    log_ok "npm run lint"
  else
    log_err "npm run lint"
    failed=1
  fi
  
  echo ""
  echo "Python lint:"
  if (cd pipeline && ruff check . 2>/dev/null); then
    log_ok "ruff check"
  else
    log_err "ruff check"
    failed=1
  fi
  
  echo ""
  if [[ $failed -eq 0 ]]; then
    log_ok "All verification checks passed"
  else
    log_err "Some checks failed"
  fi
}

cmd_maps() {
  log_info "Regenerating agent maps..."
  ./.agent/scripts/regenerate-maps.sh manual
  log_ok "Maps regenerated"
}

cmd_predict() {
  local spec="${1:-}"
  if [[ -z "$spec" ]]; then
    log_err "Usage: fx-agent predict <spec.md>"
    exit 1
  fi
  ./.agent/scripts/predict-failures.sh "$spec"
}

cmd_help() {
  cat << 'EOF'
FX Regime Lab — Agent System CLI

USAGE:
  fx-agent <command> [options]

COMMANDS:
  init                    One-time system setup
  status                  Show system health and stats
  spec create <type>      Create spec from template
                          Types: signal, page, migration
  spec validate <file>    Validate spec before delegation
  run <spec.md>           Execute single spec via Cursor
  run --queue             Process all queued specs
  verify                  Run full test/build/lint suite
  maps                    Regenerate all agent maps
  predict <spec.md>       Predict failure modes in spec

WORKFLOW:
  1. fx-agent spec create signal    # write your spec
  2. fx-agent run spec.md           # delegate to Cursor
  3. fx-agent verify                # verify everything
  4. git commit                     # hooks auto-update maps

AGENTS:
  Kimi  = Strategy (plans, researches, decides)
  Cursor = Execution (implements, tests, reports)

For details: cat .agent/index.json
EOF
}

# ─── MAIN ──────────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  init)           cmd_init "$@" ;;
  status)         cmd_status "$@" ;;
  spec)           
    SUB="${1:-}"
    shift || true
    case "$SUB" in
      create)     cmd_spec_create "$@" ;;
      validate)   cmd_spec_validate "$@" ;;
      *)          cmd_help ;;
    esac
    ;;
  run)            cmd_run "$@" ;;
  verify)         cmd_verify "$@" ;;
  maps)           cmd_maps "$@" ;;
  predict)        cmd_predict "$@" ;;
  help|--help|-h) cmd_help ;;
  *)              log_err "Unknown command: $COMMAND"; cmd_help; exit 1 ;;
esac
