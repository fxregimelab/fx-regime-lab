{
  "meta": {
    "project": "FX Regime Lab",
    "version": "4.0",
    "agent_model": "Kimi = Strategy, Cursor = Execution",
    "last_updated": "2026-05-06",
    "rating": "11/10 agentic codebase"
  },
  "quick_start": {
    "init": "./scripts/init-agent-system.sh",
    "health_check": "./scripts/agent-health-check.sh",
    "for_kimi": [
      "Read .agent/index.json (this file)",
      "Read .agent/maps/CODEMAP.json \u2014 find files without grepping",
      "Read .agent/maps/SKILLMAP.json \u2014 find the right skill",
      "Read .agent/context/HOTFILES.md \u2014 see what's active",
      "Read TASK.md \u2014 current sprint",
      "Read .agent/budget.json \u2014 know your token budget"
    ],
    "for_cursor": [
      "Read .cursorrules \u2014 hard rules",
      "Read .cursor/rules/*.mdc \u2014 auto-applied rules",
      "Read .cursor/skills/*/SKILL.md \u2014 relevant skill",
      "Read Implementation Spec from Kimi \u2014 execute exactly"
    ]
  },
  "maps": {
    "CODEMAP": ".agent/maps/CODEMAP.json \u2014 codebase file + function registry",
    "SKILLMAP": ".agent/maps/SKILLMAP.json \u2014 all 13 skills",
    "RULEMAP": ".agent/maps/RULEMAP.json \u2014 all 6 Cursor rules",
    "HOTFILES": ".agent/context/HOTFILES.md \u2014 recently modified files"
  },
  "agents": {
    "kimi": {
      "role": "Strategy, research, planning, verification",
      "never_writes": "Production code (only specs, tests, docs)",
      "delegates_to": "Cursor Agent CLI via scripts/kimi-cursor-orchestrator.sh",
      "config": "~/.kimi/config.toml",
      "reads": [
        ".agent/index.json",
        ".agent/maps/*.json",
        ".agent/context/HOTFILES.md",
        "TASK.md"
      ]
    },
    "cursor": {
      "role": "Execution, implementation, refactoring",
      "never_plans": "Only executes Kimi Implementation Specs",
      "config": ".cursor/settings.json",
      "reads": [
        ".cursorrules",
        ".cursor/AGENTS.md",
        ".cursor/rules/*.mdc"
      ]
    }
  },
  "scripts": {
    "init": "scripts/init-agent-system.sh \u2014 one-command setup",
    "health_check": "scripts/agent-health-check.sh \u2014 verify system health",
    "kimi-cursor-orchestrator": "scripts/kimi-cursor-orchestrator.sh \u2014 master orchestrator",
    "cursor-delegate": "scripts/cursor-delegate.sh \u2014 single task delegation",
    "cursor-verify": "scripts/cursor-verify.sh \u2014 test/build/lint verification",
    "cursor-warmup": "scripts/cursor-warmup.sh \u2014 pre-warm codebase index",
    "regenerate-maps": ".agent/scripts/regenerate-maps.sh \u2014 regenerate all maps",
    "file-watcher": ".agent/scripts/file-watcher.sh \u2014 background watcher",
    "build-semantic-map": ".agent/scripts/build-semantic-map.sh \u2014 extract semantic meaning from code",
    "predictive-loader": ".agent/scripts/predictive-loader.sh \u2014 predict which context to load",
    "spec-validator": ".agent/scripts/spec-validator.sh \u2014 validate Implementation Specs",
    "auto-debug": ".agent/scripts/auto-debug.sh \u2014 automatic error parsing + fix generation",
    "worktree-runner": ".agent/scripts/worktree-runner.sh \u2014 isolated worktree execution"
  },
  "infrastructure": {
    "git_hooks": "Auto-regenerate maps on commit/merge. Pre-commit runs tests.",
    "file_watcher": "Background process regenerates maps on file changes.",
    "auto_retry": "Orchestrator auto-retries failed specs with Fix Specs.",
    "templates": ".agent/templates/*.md \u2014 pre-built spec templates",
    "decisions": ".agent/decisions/*.json \u2014 machine-readable decision trees",
    "budget": ".agent/budget.json \u2014 token budget per session",
    "semantic_map": ".agent/maps/SEMANTICMAP.json \u2014 function-level semantic understanding (108 files)",
    "predictive_loader": ".agent/scripts/predictive-loader.sh \u2014 task \u2192 relevant files/skills/rules",
    "spec_validator": ".agent/scripts/spec-validator.sh \u2014 validate specs before delegation",
    "auto_debug": ".agent/scripts/auto-debug.sh \u2014 auto-parse errors and generate Fix Specs",
    "worktree_runner": ".agent/scripts/worktree-runner.sh \u2014 isolated git worktree execution",
    "agent_bridge": ".agent/bridge/ \u2014 two-way structured communication between agents",
    "context_compression": ".agent/compress/ \u2014 auto-summarize large files when context is full"
  },
  "hard_rules": {
    "pairs": "EUR/USD, USD/JPY, USD/INR ONLY",
    "db_writes": "ALL writes through pipeline/src/db/writer.py",
    "ai_calls": "ALL AI through pipeline/src/ai/client.py (ON HOLD)",
    "immutable": "regime_calls and validation_log are append-only",
    "no_github_actions": "Prefect Cloud only",
    "tests": "pytest 121 tests + npm run build must pass"
  }
}