# Copy to `.env` and replace every placeholder with real values.
# Never commit `.env` (gitignored).

# ── Pipeline ───────────────────────────────────────────────────────────────────

# FRED API (free) — used for US 2Y yields and macro release calendar
# Register at: https://fred.stlouisfed.org → My Account → API Keys
FRED_API_KEY=your_fred_api_key_here

# Polygon.io (primary) — institutional-grade FX spot OHLC aggregates
# https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Alpha Vantage (free tier) — secondary FX spot OHLC (FX_DAILY)
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# 3-tier FX spot fallback chain:
#   1. Polygon.io   (primary)   — C:EURUSD aggregates, 5+ years history
#   2. Alpha Vantage (secondary) — FX_DAILY, 25 calls/day limit
#   3. yfinance     (tertiary)  — Yahoo Finance, free but less reliable

# Supabase — Project Settings → API in your dashboard
# Project ref is the 20-char ID in your project URL: https://<ref>.supabase.co
SUPABASE_PROJECT_REF=your_20_char_project_ref
SUPABASE_URL=https://your_20_char_project_ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenRouter (free AI models — pipeline AI briefs only)
# Register at: https://openrouter.ai → Keys  (free, no credit card needed)
# Models are hardcoded in pipeline/src/ai/client.py:
#   Primary:  minimax/minimax-m1:free
#   Fallback: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Web (Next.js) — `/api/linkedin-alpha-hook` uses the same OPENROUTER_API_KEY server-side.
# Optional: canonical site URL for LLM [LINK] lines (Python + API route default: https://fxregimelab.com)
# SITE_PUBLIC_URL=https://fxregimelab.com

# ── Alerting (P0-T3) ───────────────────────────────────────────────────────────
# Slack webhook for pipeline failure + success heartbeat
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Resend API key for DQS < 0.70 email alerts
# Register at: https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
ALERT_EMAIL_FROM=alerts@fxregimelab.com
ALERT_EMAIL_TO=ops@fxregimelab.com

# ── Optional / future ──────────────────────────────────────────────────────────
# TWELVE_DATA_KEY=     # backup FX data (not used yet)
# POLYGON_KEY=         # backup FX data (not used yet)

# ── Prefect Cloud ──────────────────────────────────────────────────────────────
# Prefect Cloud API key for flow deployment and monitoring
# Get from: https://app.prefect.cloud → API Keys
PREFECT_API_KEY=your_prefect_api_key_here

# Prefect Cloud API URL (includes account ID)
# Found in Prefect Cloud → Settings → API URL
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/YOUR_ACCOUNT_ID

# Prefect Cloud User ID (optional, for reference)
PREFECT_CLOUD_USER_ID=your_user_id_here
