{
  "chat": {
    "defaultModel": "claude-sonnet-4-5",
    "alwaysReadFiles": ["AGENTS.md", "TASK.md", ".cursorrules"],
    "contextStrategy": "focused"
  },
  "indexing": {
    "respectGitignore": true,
    "maxFileSize": 500000
  },
  "editor": {
    "formatOnSave": true,
    "defaultFormatter": "prettier"
  },
  "plugins": {
    "cloudflare": {
      "enabled": true
    },
    "context7-plugin": {
      "enabled": true
    },
    "vercel": {
      "enabled": true
    }
  },
  "skills": {
    "autoLoad": true,
    "paths": [
      ".cursor/skills"
    ]
  },
  "subagents": {
    "autoLoad": true,
    "paths": [
      ".cursor/subagents"
    ]
  },
  "hooks": {
    "preSession": ".cursor/hooks/pre-session.md",
    "postSession": ".cursor/hooks/post-session.md"
  },
  "commands": {
    "paths": [
      ".cursor/commands"
    ]
  },
  "delegation": {
    "enabled": true,
    "defaultModel": "claude-sonnet-4-5",
    "autoApproveMCPs": true,
    "trustWorkspace": true,
    "queueDir": ".cursor/delegation/queue",
    "logsDir": ".cursor/delegation/logs",
    "sessionsDir": ".cursor/delegation/sessions",
    "specsDir": ".cursor/delegation/specs",
    "maxRetries": 2,
    "defaultParallel": 1
  }
}
